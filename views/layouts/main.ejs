<% if (typeof partial === 'undefined' || partial === 'start') { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — Library' : 'Library' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav class="nav">
    <a href="/books" class="nav-brand">Library</a>
    <div class="nav-links">
      <a href="/books">Books</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="nav-user"><%= user.firstName %></span>
        <form class="logout-form" method="POST" action="/auth/logout">
          <button type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/auth/signin">Sign in</a>
        <a href="/auth/signup">Sign up</a>
      <% } %>
    </div>
  </nav>
  <main class="container">
<% } else if (partial === 'end') { %>
  </main>
</body>
</html>
<% } %>
